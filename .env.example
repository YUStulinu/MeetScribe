# Required — used to generate meeting summaries and action items
ANTHROPIC_API_KEY=put_your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — only needed to upload audio files (speaker diarization).
# Live recording works without this, using your browser's speech recognition.
OPENAI_API_KEY=
OPENAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

PORT=3004

# How often the live rolling summary refreshes
SUMMARY_MIN_INTERVAL_MS=30000
SUMMARY_MIN_NEW_CHARS=280
